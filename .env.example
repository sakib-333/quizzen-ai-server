NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173

GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Created by `npm run convex:dev`. CONVEX_URL must point to the same
# deployment named by CONVEX_DEPLOYMENT.
CONVEX_DEPLOYMENT=dev:replace-with-your-deployment-name
CONVEX_URL=https://replace-with-your-deployment.convex.cloud
CONVEX_SITE_URL=https://replace-with-your-deployment.convex.site

# Firebase Admin service-account credentials. Keep the private key on one line
# with its newlines escaped as \n, especially when configuring Vercel.
FIREBASE_PROJECT_ID=replace-with-your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-private-key\n-----END PRIVATE KEY-----\n"